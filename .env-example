# ============================================================
# 复制本文件为 .env，填入你自己的 API Key
# cp .env-example .env
# ============================================================

# 推荐：DeepSeek（国内便宜、稳定、兼容 OpenAI 协议）
# 申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 备选：通义千问 / 阿里百炼
# 申请：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI（可选，需要能访问）
# 申请：https://platform.openai.com/
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ----- 通用配置（被代码读取）-----
# 默认用哪个模型提供商：deepseek | qwen | openai | ollama
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 通义千问（兼容 OpenAI 协议的入口）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Ollama（本地，无需 Key）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
